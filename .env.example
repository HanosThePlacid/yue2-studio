# Copy to .env (repo root) and edit. The install scripts write this file for you.
# Real environment variables override values here.

# audio.cpp CLI binary (default: <repo>/engine/bin/audiocpp_cli[.exe])
# AUDIOCPP_CLI=/path/to/audiocpp_cli

# Folder holding the YuE2 GGUF files + sidecars/ (default: <repo>/models/Yue2-3B-GGUF)
# YUE2_MODEL_DIR=/path/to/Yue2-3B-GGUF

# Main model file inside YUE2_MODEL_DIR: yue2-3b-q4_0.gguf (~2.5 GB) | yue2-3b-q8_0.gguf | yue2-3b-bf16.gguf
YUE2_MODEL_GGUF=yue2-3b-q4_0.gguf

# Engine backend; must match the engine build: cuda | vulkan | cpu
YUE2_BACKEND=cuda

# Optional extra dir with CUDA runtime libs (Linux: prepended to LD_LIBRARY_PATH, Windows: PATH)
# CUDA_LIB=/usr/local/cuda/lib64

# Production server (npm start). HOST=0.0.0.0 exposes it on your LAN; there is no auth.
PORT=8000
# HOST=127.0.0.1

# YUE2_ROOT=   (data root, default: repo root)
# YUE2_DB=     (default: <root>/data/studio.db)
